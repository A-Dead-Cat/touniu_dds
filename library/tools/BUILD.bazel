load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LOCAL_DEFINES", "DDS_LINKOPTS")

cc_binary(
    name = "touniu_solver_benchmark",
    srcs = ["touniu_solver_benchmark.cpp"],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    deps = ["//library/src/touniu_solver:search"],
)

cc_binary(
    name = "touniu_heuristic_eval",
    srcs = ["touniu_heuristic_eval.cpp"],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    deps = ["//library/src/touniu_solver:search"],
)

cc_library(
    name = "heuristic_policy",
    srcs = ["touniu_heuristic_eval.cpp"],
    hdrs = ["heuristic_policy.hpp"],
    copts = DDS_CPPOPTS + ["-Wno-unused-function", "-Wno-unused-variable"],
    local_defines = DDS_LOCAL_DEFINES + ["TOUNIU_HEURISTIC_POLICY_ONLY=1"],
    deps = ["//library/src/touniu_solver:search"],
    visibility = ["//visibility:public"],
)
