load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LINKOPTS", "DDS_LOCAL_DEFINES")

# Single-threaded Touniu solver module: no pthread pool, no demo page.
TOUNIU_WASM_LINKOPTS = [
    "-sWASM=1",
    "--no-entry",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sMODULARIZE=1",
    "-sEXPORT_NAME=createTouniuSolver",
    "-sEXPORTED_FUNCTIONS=['_touniu_solver_solve','_touniu_solver_analyze_actions_v2','_malloc','_free']",
    "-sEXPORTED_RUNTIME_METHODS=['getValue','setValue']",
    "-sENVIRONMENT=worker,node",
    "-sINCOMING_MODULE_JS_API=['wasmBinary']",
]

cc_binary(
    name = "touniu_solver_wasm_cc",
    srcs = ["touniu_solver_module.cpp"],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS + select({
        "//:build_wasm": TOUNIU_WASM_LINKOPTS,
        "//conditions:default": [],
    }),
    local_defines = DDS_LOCAL_DEFINES,
    deps = ["//library/src/touniu_solver:c_api"],
)

wasm_cc_binary(
    name = "touniu_solver_wasm",
    cc_target = ":touniu_solver_wasm_cc",
    threads = "off",
    outputs = [
        "touniu_solver.js",
        "touniu_solver.wasm",
    ],
)

py_test(
    name = "touniu_solver_wasm_test",
    size = "small",
    timeout = "short",
    main = "tests/test_touniu_solver_wasm.py",
    srcs = [
        "tests/test_touniu_solver_wasm.py",
        "tests/touniu_solver_wasm_node.mjs",
    ],
    data = [
        ":touniu_solver_wasm",
    ],
)


wasm_cc_binary(
    name = "solve_board_wasm",
    cc_target = "//examples:solve_board",
    threads = "emscripten",
    outputs = [
        "solve_board.js",
        "solve_board.wasm",
    ],
)

wasm_cc_binary(
    name = "analyse_play_bin_wasm",
    cc_target = "//examples:AnalysePlayBin",
    threads = "emscripten",
    outputs = [
        "AnalysePlayBin.js",
        "AnalysePlayBin.wasm",
    ],
)

wasm_cc_binary(
    name = "calc_dd_table_pbn_wasm",
    cc_target = "//examples:calc_dd_table_pbn",
    threads = "emscripten",
    outputs = [
        "calc_dd_table_pbn.js",
        "calc_dd_table_pbn.wasm",
    ],
)

# dtest harness under Node (reads host hand-list files via NODERAWFS).
wasm_cc_binary(
    name = "dtest_wasm",
    cc_target = "//library/tests:dtest",
    threads = "emscripten",
    outputs = [
        "dtest.js",
        "dtest.wasm",
    ],
)

# `bazelisk run //wasm:run_dtest_wasm -- -f hands/list2.txt -s solve -n 2`
py_binary(
    name = "run_dtest_wasm",
    srcs = ["run_dtest_wasm.py"],
    main = "run_dtest_wasm.py",
    data = [":dtest_wasm"],
)

py_test(
    name = "run_dtest_wasm_test",
    size = "small",
    srcs = [
        "run_dtest_wasm.py",
        "tests/test_run_dtest_wasm.py",
    ],
    main = "tests/test_run_dtest_wasm.py",
    imports = ["."],
)

filegroup(
    name = "all_examples_wasm",
    srcs = [
        ":analyse_play_bin_wasm",
        ":calc_dd_table_pbn_wasm",
        ":solve_board_wasm",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "calc_dd_table_pbn_test",
    size = "small",
    srcs = ["calc_dd_table_pbn_test.cpp"],
    copts = DDS_CPPOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    deps = [
        "//examples:hands",
        "//library/src:dds",
        "//library/src/api:api_definitions",
        "@googletest//:gtest_main",
    ],
)

py_test(
    name = "wasm_examples_system_test",
    size = "small",
    timeout = "short",
    main = "tests/test_wasm_examples_system.py",
    srcs = ["tests/test_wasm_examples_system.py"],
    data = [
        ":calc_dd_table_pbn_wasm",
        ":dtest_wasm",
        "//hands:list1.txt",
        "//hands:list2.txt",
    ],
)

test_suite(
    name = "all",
    tests = [
        ":calc_dd_table_pbn_test",
        ":run_dtest_wasm_test",
        ":touniu_solver_wasm_test",
        ":wasm_examples_system_test",
    ],
)

test_suite(
    name = "wasm_system_tests",
    tests = [":wasm_examples_system_test"],
)
